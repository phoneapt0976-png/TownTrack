{
  "name": "towntrack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build && node scripts/static-aliases.mjs",
    "preview": "node server.mjs --production",
    "start": "node server.mjs --production",
    "db:seed:demo": "node --env-file=.env.local scripts/seed-demo-neon.mjs",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:sync": "npm run build && cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/inappbrowser": "^4.0.4",
    "@capacitor/ios": "^8.5.3",
    "@line/liff": "^2.31.2",
    "@neondatabase/serverless": "^1.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rollup-plugin-natives": "^0.7.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
