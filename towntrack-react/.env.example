# Leave issuer/client blank to open the five role pages in local demo mode.
# Register public clients (no client secret) with Authorization Code + PKCE.
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=http://localhost:8770/auth/callback

# Native uses the reverse-domain app scheme configured in the iOS/Android projects.
# Register this callback with your provider; use a separate public client if required.
VITE_OIDC_NATIVE_CLIENT_ID=
VITE_OIDC_NATIVE_REDIRECT_URI=com.towntrack.app://auth/callback

VITE_OIDC_SCOPE=openid profile email
VITE_OIDC_ROLE_CLAIM=roles

# Optional LINE LIFF entry for citizen reporting; use its LIFF URL in the OA Rich Menu.
VITE_LINE_LIFF_ID=2012227993-tgksP03U

# Optional official-account chat URL, for example https://line.me/R/ti/p/@youraccount
VITE_LINE_OA_URL=

# Public agency details. Fill with approved information before production.
# These values are visible in the browser; never put secrets here.
VITE_AGENCY_NAME=
VITE_AGENCY_ADDRESS=
VITE_AGENCY_PHONE=
VITE_AGENCY_EMAIL=
VITE_AGENCY_SERVICE_HOURS=

# External URLs must use HTTPS. Leave blank when not supplied.
VITE_AGENCY_WEBSITE=
VITE_AGENCY_FEEDBACK_URL=
VITE_AGENCY_PRIVACY_URL=
VITE_AGENCY_WEBSITE_POLICY_URL=
VITE_AGENCY_SECURITY_POLICY_URL=

# Optional local-only Neon development URL for the demo-data seed script. Never use a VITE_ prefix.
DATABASE_URL=